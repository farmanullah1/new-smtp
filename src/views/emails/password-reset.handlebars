<div style="text-align: left;">
  <span class="badge badge-warning">Password Recovery</span>
  <h2 style="color: #0f172a; margin: 14px 0 8px 0; font-size: 22px; font-weight: 800;">🔓 Reset Your Password</h2>
  <p style="color: #475569; margin: 0 0 8px 0;">
    Hello <strong>{{name}}</strong>, we received a request to reset the password for your account associated with <strong>{{recipientEmail}}</strong>.
  </p>
  <p style="color: #475569; margin: 0 0 20px 0;">
    Use the following 6-digit code to authenticate your password reset:
  </p>

  <!-- OTP Individual Digit Cells -->
  <div class="otp-code-box">
    <!--[if mso]>
    <p class="otp-fallback">{{otpCode}}</p>
    <![endif]-->
    <!--[if !mso]><!-->
    <div class="otp-digits-row">
      {{#each otpDigits}}
      <span class="otp-digit-cell">{{this}}</span>
      {{/each}}
    </div>
    <!--<![endif]-->
    <p class="otp-subtext">Code expires in <strong>{{expiryMinutes}} minutes</strong></p>
    <span class="otp-timer-badge">⏱ Act quickly — code is time-limited</span>
  </div>

  <table class="meta-table" role="presentation">
    <tr>
      <td class="meta-label">🕐 Requested At:</td>
      <td class="meta-val">{{formattedDate}}</td>
    </tr>
    <tr>
      <td class="meta-label">🌐 From IP:</td>
      <td class="meta-val"><code style="background: #f1f5f9; padding: 2px 8px; border-radius: 4px; font-family: monospace; font-size: 13px; color: #1e293b;">{{ipAddress}}</code></td>
    </tr>
  </table>

  <div class="security-notice" style="border-left-color: #ef4444; background-color: #fef2f2; color: #991b1b;">
    <strong>🚨 Didn't request this?</strong> If you did not ask for a password reset, please ignore this email. Your password will remain unchanged. If you are concerned about unauthorized access, please contact support.
  </div>
</div>
