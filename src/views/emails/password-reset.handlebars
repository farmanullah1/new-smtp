<div style="text-align: left;">
  <span class="badge badge-warning">Password Recovery</span>
  <h2 style="color: #0f172a; margin: 12px 0 8px 0; font-size: 20px;">Reset Your Password</h2>
  <p style="color: #475569; margin: 0 0 16px 0;">
    Hello <strong>{{name}}</strong>, we received a request to reset the password for your account associated with <strong>{{recipientEmail}}</strong>.
  </p>

  <p style="color: #475569; margin: 0 0 12px 0;">
    Use the following 6-digit verification code to authenticate your password reset request:
  </p>

  <div class="otp-code-box">
    <p class="otp-digits">{{otpCode}}</p>
    <p class="otp-subtext">Code expires in {{expiryMinutes}} minutes</p>
  </div>

  <table class="meta-table" role="presentation">
    <tr>
      <td class="meta-label">Request Timestamp:</td>
      <td class="meta-val">{{formattedDate}}</td>
    </tr>
    <tr>
      <td class="meta-label">Requested From IP:</td>
      <td class="meta-val">{{ipAddress}}</td>
    </tr>
  </table>

  <div class="security-notice">
    <strong>Did not request this?</strong> If you did not request a password reset, please ignore this email or contact support. Your password will remain unchanged.
  </div>
</div>
