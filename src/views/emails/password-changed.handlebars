<div style="text-align: left;">
  <span class="badge badge-success">Security Update</span>
  <h2 style="color: #0f172a; margin: 14px 0 8px 0; font-size: 22px; font-weight: 800;">✅ Password Changed Successfully</h2>
  <p style="color: #475569; margin: 0 0 20px 0;">
    Hello <strong>{{name}}</strong>, the password for your account (<strong>{{recipientEmail}}</strong>) was successfully updated.
  </p>

  <!-- Success visual -->
  <div style="text-align: center; margin: 24px 0;">
    <div style="display: inline-block; width: 64px; height: 64px; line-height: 64px; border-radius: 50%; background: linear-gradient(135deg, #dcfce7, #bbf7d0); font-size: 32px; text-align: center;">✓</div>
    <p style="color: #16a34a; font-weight: 700; font-size: 14px; margin: 10px 0 0 0;">Password Updated</p>
  </div>

  <table class="meta-table" role="presentation">
    <tr>
      <td class="meta-label">🕐 Changed At:</td>
      <td class="meta-val">{{formattedDate}}</td>
    </tr>
    <tr>
      <td class="meta-label">🌐 IP Address:</td>
      <td class="meta-val"><code style="background: #f1f5f9; padding: 2px 8px; border-radius: 4px; font-family: monospace; font-size: 13px; color: #1e293b;">{{ipAddress}}</code></td>
    </tr>
    <tr>
      <td class="meta-label">💻 Device:</td>
      <td class="meta-val" style="font-size: 12px; word-break: break-all;">{{userAgent}}</td>
    </tr>
  </table>

  <div class="security-notice" style="border-left-color: #ef4444; background-color: #fef2f2; color: #991b1b;">
    <strong>🚨 Didn't make this change?</strong> If you did NOT update your password, your account may be compromised. Take these steps immediately:
    <ol style="margin: 10px 0 0 0; padding-left: 20px; font-size: 13px; line-height: 1.8;">
      <li>Reset your password using the link below</li>
      <li>Review your recent login history</li>
      <li>Contact support if suspicious activity continues</li>
    </ol>
  </div>

  <div style="text-align: center;">
    <a href="{{clientUrl}}/login" class="action-button">Sign In With New Password &rarr;</a>
  </div>
</div>
