<div style="text-align: left;">
  <span class="badge badge-success">Security Update</span>
  <h2 style="color: #0f172a; margin: 12px 0 8px 0; font-size: 20px;">Password Changed Successfully</h2>
  <p style="color: #475569; margin: 0 0 16px 0;">
    Hello <strong>{{name}}</strong>, the password for your account (<strong>{{recipientEmail}}</strong>) was successfully updated.
  </p>

  <table class="meta-table" role="presentation">
    <tr>
      <td class="meta-label">Changed At:</td>
      <td class="meta-val">{{formattedDate}}</td>
    </tr>
    <tr>
      <td class="meta-label">IP Address:</td>
      <td class="meta-val">{{ipAddress}}</td>
    </tr>
    <tr>
      <td class="meta-label">Client Device:</td>
      <td class="meta-val">{{userAgent}}</td>
    </tr>
  </table>

  <div class="security-notice" style="border-left-color: #ef4444; background-color: #fef2f2; color: #991b1b;">
    <strong>Crucial Security Alert:</strong> If you did not make this change, please contact our support team immediately as someone else may have unauthorized access to your account.
  </div>

  <div style="text-align: center;">
    <a href="{{clientUrl}}/login" class="action-button">Sign In With New Password</a>
  </div>
</div>
