<div style="text-align: left;">
  <span class="badge badge-warning">Security Alert</span>
  <h2 style="color: #0f172a; margin: 12px 0 8px 0; font-size: 20px;">New Login Detected</h2>
  <p style="color: #475569; margin: 0 0 16px 0;">
    Hello <strong>{{name}}</strong>, we detected a new sign-in to your <strong>{{appName}}</strong> account.
  </p>

  <table class="meta-table" role="presentation">
    <tr>
      <td class="meta-label">Time:</td>
      <td class="meta-val">{{formattedDate}}</td>
    </tr>
    <tr>
      <td class="meta-label">IP Address:</td>
      <td class="meta-val">{{ipAddress}}</td>
    </tr>
    <tr>
      <td class="meta-label">Device / Client:</td>
      <td class="meta-val">{{userAgent}}</td>
    </tr>
    <tr>
      <td class="meta-label">Status:</td>
      <td class="meta-val"><span class="badge badge-success">Successful</span></td>
    </tr>
  </table>

  <div class="security-notice">
    <strong>Was this you?</strong> If you recently logged in from this device, you can safely ignore this email. If this wasn't you, your account may be compromised. Please reset your password immediately using the link below:
  </div>

  <div style="text-align: center;">
    <a href="{{clientUrl}}/forgot-password" class="action-button" style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);">Secure Your Account</a>
  </div>
</div>
