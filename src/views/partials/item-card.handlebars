<!-- Resource Item Grid Card -->
<div class="glass-panel resource-card" style="padding: 22px; display: flex; flex-direction: column; justify-content: space-between; border-left: 3px solid {{#if (eq this.status 'active')}}#10b981{{else if (eq this.status 'draft')}}#f59e0b{{else}}#64748b{{/if}};">
  <div>
    <!-- Category & Status Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; gap: 8px;">
      <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; font-weight: 700;">
        📂 {{this.category}}
      </span>
      <div style="display: flex; gap: 6px; align-items: center;">
        <span class="badge {{priorityBadgeClass this.priority}}">{{this.priority}}</span>
        <span class="badge {{statusBadgeClass this.status}}">{{this.status}}</span>
      </div>
    </div>

    <!-- Title -->
    <h3 style="font-size: 17px; color: #f8fafc; margin-bottom: 8px; line-height: 1.3;">
      {{this.title}}
    </h3>

    <!-- Description -->
    <p style="color: #94a3b8; font-size: 13px; line-height: 1.5; margin-bottom: 16px;">
      {{#if this.description}}{{this.description}}{{else}}No detailed description provided.{{/if}}
    </p>

    <!-- Tags -->
    {{#if this.tags.length}}
      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px;">
        {{#each this.tags}}
          <span class="tag-pill">
            🏷️ {{this}}
          </span>
        {{/each}}
      </div>
    {{/if}}
  </div>

  <!-- Footer Actions -->
  <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.06); font-size: 12px; color: #64748b;">
    <span title="{{formatDateTime this.createdAt}}">🕒 {{timeAgo this.createdAt}}</span>
    <div style="display: flex; gap: 8px;">
      <button type="button" class="btn btn-secondary btn-sm btn-edit-item" data-item="{{attrJson this}}" title="Edit Resource">
        ✏️ Edit
      </button>
      <button type="button" class="btn btn-danger btn-sm btn-delete-item" data-id="{{this.id}}" data-title="{{this.title}}" title="Delete Resource" aria-label="Delete {{this.title}}">
        🗑️
      </button>
    </div>
  </div>
</div>
