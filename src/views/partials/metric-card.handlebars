<!-- Dashboard Metric KPI Card -->
<div class="glass-panel metric-card" style="padding: 20px;">
  <div style="display: flex; align-items: center; justify-content: space-between; color: #94a3b8; margin-bottom: 8px;">
    <span style="font-size: 13px; font-weight: 600;">{{title}}</span>
    <span style="font-size: 20px;">{{icon}}</span>
  </div>
  <div style="font-size: 28px; font-weight: 800; color: {{#if color}}{{color}}{{else}}#f8fafc{{/if}};">
    {{defaultVal value 0}}
  </div>
  {{#if subtitle}}
    <div style="font-size: 11px; color: #64748b; margin-top: 4px;">{{subtitle}}</div>
  {{/if}}
</div>
