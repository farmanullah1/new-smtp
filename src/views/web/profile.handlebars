<div style="max-width: 1080px; margin: 0 auto;">
  <!-- User Hero Banner -->
  <div class="glass-panel" style="padding: 28px; margin-bottom: 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
    <div style="display: flex; align-items: center; gap: 20px;">
      {{#if currentUser.avatarUrl}}
        <img src="{{currentUser.avatarUrl}}" alt="{{currentUser.name}}" style="width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-primary); box-shadow: 0 0 16px rgba(99, 102, 241, 0.4);" onerror="this.style.display='none'">
      {{else}}
        <div style="width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 800; color: #ffffff; box-shadow: 0 0 20px rgba(99, 102, 241, 0.4);">
          {{userInitial currentUser.name}}
        </div>
      {{/if}}

      <div>
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <h1 style="font-size: 24px; margin: 0;">{{currentUser.name}}</h1>
          <span class="badge badge-info">{{currentUser.role}}</span>
          {{#if currentUser.isVerified}}
            <span class="badge badge-success">✓ Verified</span>
          {{else}}
            <span class="badge badge-warning">Pending Verification</span>
          {{/if}}
        </div>
        <p style="color: #94a3b8; font-size: 14px; margin-top: 4px;">{{currentUser.email}}</p>
        {{#if currentUser.lastLoginAt}}
          <p style="color: #64748b; font-size: 12px; margin-top: 2px;" title="{{formatDateTime currentUser.lastLoginAt}}">
            🕒 Last active: {{timeAgo currentUser.lastLoginAt}} ({{formatDate currentUser.lastLoginAt}})
          </p>
        {{/if}}
      </div>
    </div>

    <div>
      <div style="padding: 10px 16px; border-radius: 8px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); text-align: center;">
        <div style="font-size: 11px; color: #94a3b8;">2FA Protection</div>
        <div style="font-size: 13px; font-weight: 700; color: {{#if currentUser.isTwoFactorEnabled}}#34d399{{else}}#9ca3af{{/if}};">
          {{#if currentUser.isTwoFactorEnabled}}Enabled{{else}}Disabled{{/if}}
        </div>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
    <!-- Profile Details Card -->
    <div class="glass-panel" style="padding: 24px;">
      <h2 style="font-size: 18px; margin-bottom: 18px;">👤 Personal Profile</h2>

      <form method="POST" action="/profile/update">
        <div class="form-group">
          <label class="form-label" for="profile-name">Full Name</label>
          <input id="profile-name" type="text" name="name" class="form-input" value="{{currentUser.name}}" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="profile-phone">Phone Number</label>
          <input id="profile-phone" type="text" name="phone" class="form-input" placeholder="+1 555-0199" value="{{currentUser.phone}}">
        </div>

        <div class="form-group">
          <label class="form-label" for="profile-avatar">Avatar Image URL</label>
          <input id="profile-avatar" type="url" name="avatarUrl" class="form-input" placeholder="https://..." value="{{currentUser.avatarUrl}}">
        </div>

        <div class="form-group">
          <label class="form-label" for="profile-bio">Bio</label>
          <textarea id="profile-bio" name="bio" class="form-textarea" placeholder="Brief summary about yourself...">{{currentUser.bio}}</textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">
          Save Profile Changes
        </button>
      </form>
    </div>

    <!-- Security & Password Card -->
    <div class="glass-panel" style="padding: 24px;">
      <h2 style="font-size: 18px; margin-bottom: 18px;">🔐 Security &amp; Credentials</h2>

      <!-- 2FA Toggle Form -->
      <form method="POST" action="/profile/2fa" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 16px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: #f8fafc;">🛡️ Two-Factor Authentication</div>
          <div style="font-size: 12px; color: #94a3b8; margin-top: 2px;">Requires 6-digit email OTP on each sign-in</div>
        </div>
        <label class="toggle-switch" aria-label="Toggle Two-Factor Authentication">
          <input type="checkbox" name="enabled" value="true" {{#if currentUser.isTwoFactorEnabled}}checked{{/if}} onchange="this.form.submit()">
          <span class="toggle-slider"></span>
        </label>
      </form>

      <!-- Change Password Form -->
      <form method="POST" action="/profile/password">
        <div class="form-group">
          <label class="form-label" for="current-password">Current Password</label>
          <input id="current-password" type="password" name="currentPassword" class="form-input" placeholder="••••••••••••" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="new-password">New Password</label>
          <div style="position: relative;">
            <input id="new-password" type="password" name="newPassword" class="form-input" placeholder="••••••••••••" minlength="6" style="padding-right: 42px;" required>
            <button type="button" class="btn-toggle-password" data-target="new-password" aria-label="Toggle password visibility" style="position: absolute; right: 12px; top: 11px; background: none; border: none; cursor: pointer; font-size: 16px;">👁️</button>
          </div>
        </div>

        <button type="submit" class="btn btn-secondary" style="width: 100%;">
          Update Password
        </button>
      </form>
    </div>
  </div>

  <!-- Email Address & Change Section -->
  <div class="glass-panel" style="padding: 24px; margin-top: 24px;">
    <h2 style="font-size: 18px; margin-bottom: 14px;">✉️ Account Email Address</h2>
    <p style="color: #94a3b8; font-size: 14px; margin-bottom: 16px;">
      Current verified address: <strong style="color: #f8fafc;">{{currentUser.email}}</strong>
    </p>

    <form method="POST" action="/profile/email" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; align-items: end;">
      <div>
        <label class="form-label" for="new-email">New Email Address</label>
        <input id="new-email" type="email" name="newEmail" class="form-input" placeholder="new.email@example.com" required>
      </div>

      <div>
        <label class="form-label" for="email-change-pw">Current Password</label>
        <input id="email-change-pw" type="password" name="currentPassword" class="form-input" placeholder="••••••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="height: 44px; width: 100%;">
        Request Email Change
      </button>
    </form>
  </div>

  <!-- Login History Audit Log -->
  <div class="glass-panel" style="padding: 24px; margin-top: 24px;">
    <h2 style="font-size: 18px; margin-bottom: 14px;">🕒 Recent Login History &amp; Audit Trail</h2>
    {{#if history.length}}
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
          <thead>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); color: #94a3b8; text-align: left;">
              <th style="padding: 10px;">When</th>
              <th style="padding: 10px;">IP Address</th>
              <th style="padding: 10px;">Client Device</th>
              <th style="padding: 10px;">Status</th>
            </tr>
          </thead>
          <tbody>
            {{#each history}}
              <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04);">
                <td style="padding: 10px; color: #f8fafc;" title="{{formatDateTime this.createdAt}}">
                  {{timeAgo this.createdAt}} ({{formatDate this.createdAt}})
                </td>
                <td style="padding: 10px; color: #38bdf8; font-family: monospace;">{{this.ipAddress}}</td>
                <td style="padding: 10px; color: #94a3b8; max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{this.userAgent}}">
                  {{truncate this.userAgent 60}}
                </td>
                <td style="padding: 10px;">
                  {{#if (eq this.status 'success')}}
                    <span class="badge badge-success">✓ Success</span>
                  {{else}}
                    <span class="badge badge-danger">✗ Failed</span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div style="color: #94a3b8; font-size: 13px;">No recorded logins found.</div>
    {{/if}}
  </div>

  <!-- Danger Zone: Delete Account -->
  <div class="glass-panel" style="padding: 24px; margin-top: 24px; border-color: rgba(244, 63, 94, 0.3); background: rgba(244, 63, 94, 0.04);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <h3 style="color: #fb7185; font-size: 16px; margin-bottom: 4px;">⚠️ Danger Zone: Delete Account</h3>
        <p style="color: #94a3b8; font-size: 13px;">
          Permanently delete your user account, OTP history, and all associated resources.
        </p>
      </div>
      <button type="button" class="btn btn-danger btn-open-modal" data-modal="delete-account-modal">
        Delete Account
      </button>
    </div>
  </div>
</div>

<!-- Delete Account Modal -->
<div id="delete-account-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="delete-account-modal-title">
  <div class="glass-panel modal-dialog" style="text-align: center; max-width: 420px;">
    <div style="font-size: 36px; margin-bottom: 12px;">⚠️</div>
    <h3 id="delete-account-modal-title" style="font-size: 19px; margin-bottom: 8px;">Confirm Permanent Deletion</h3>
    <p style="color: #94a3b8; font-size: 13px; margin-bottom: 18px;">
      Please enter your password to confirm that you wish to close this account permanently.
    </p>

    <form method="POST" action="/profile/delete-account">
      <input type="password" name="password" class="form-input" placeholder="Enter current password" style="margin-bottom: 20px;" required aria-label="Current Password">

      <div style="display: flex; gap: 12px;">
        <button type="button" class="btn btn-secondary btn-close-modal" data-modal="delete-account-modal" style="flex: 1;">Cancel</button>
        <button type="submit" class="btn btn-danger" style="flex: 1;">Delete My Account</button>
      </div>
    </form>
  </div>
</div>
