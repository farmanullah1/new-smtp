<div>
  <!-- Header & Actions -->
  <div class="page-header">
    <div>
      <h1 style="font-size: 28px; margin-bottom: 4px;">Resource Management</h1>
      <p style="color: #94a3b8; font-size: 14px;">
        Production CRUD operations connected directly to your database with live updates
      </p>
    </div>
    <button type="button" class="btn btn-primary" id="btn-create-item">
      <span>➕ New Resource</span>
    </button>
  </div>

  <!-- Metrics Cards Banner -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 28px;">
    {{> metric-card title="Total Resources" value=stats.total icon="📁" color="#f8fafc"}}
    {{> metric-card title="Active Items" value=stats.active icon="✅" color="#34d399"}}
    {{> metric-card title="Drafts" value=stats.draft icon="📝" color="#fbbf24"}}
    {{> metric-card title="Archived" value=stats.archived icon="📦" color="#94a3b8"}}
  </div>

  <!-- Filters & Search Form -->
  <form method="GET" action="/dashboard" class="glass-panel" style="padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div style="display: flex; align-items: center; gap: 12px; flex: 1; min-width: 260px;">
      <input type="text" name="q" class="form-input" placeholder="Search items by title or description..." value="{{query.q}}" aria-label="Search resources">
    </div>

    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
      <select name="status" class="form-select" style="width: 130px;" onchange="this.form.submit()" aria-label="Filter by status">
        <option value="">All Statuses</option>
        <option value="active" {{#if (eq query.status 'active')}}selected{{/if}}>Active</option>
        <option value="draft" {{#if (eq query.status 'draft')}}selected{{/if}}>Draft</option>
        <option value="archived" {{#if (eq query.status 'archived')}}selected{{/if}}>Archived</option>
      </select>

      <select name="category" class="form-select" style="width: 140px;" onchange="this.form.submit()" aria-label="Filter by category">
        <option value="">All Categories</option>
        <option value="general" {{#if (eq query.category 'general')}}selected{{/if}}>General</option>
        <option value="smtp" {{#if (eq query.category 'smtp')}}selected{{/if}}>SMTP</option>
        <option value="auth" {{#if (eq query.category 'auth')}}selected{{/if}}>Auth</option>
        <option value="database" {{#if (eq query.category 'database')}}selected{{/if}}>Database</option>
        <option value="api" {{#if (eq query.category 'api')}}selected{{/if}}>API</option>
        <option value="infrastructure" {{#if (eq query.category 'infrastructure')}}selected{{/if}}>Infrastructure</option>
      </select>

      <select name="sort" class="form-select" style="width: 150px;" onchange="this.form.submit()" aria-label="Sort resources">
        <option value="createdAt-DESC" {{#if (eq query.sort 'createdAt-DESC')}}selected{{/if}}>Newest First</option>
        <option value="createdAt-ASC" {{#if (eq query.sort 'createdAt-ASC')}}selected{{/if}}>Oldest First</option>
        <option value="title-ASC" {{#if (eq query.sort 'title-ASC')}}selected{{/if}}>Title (A-Z)</option>
        <option value="title-DESC" {{#if (eq query.sort 'title-DESC')}}selected{{/if}}>Title (Z-A)</option>
      </select>

      <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
      {{#if hasActiveFilters}}
        <a href="/dashboard" class="btn btn-secondary btn-sm" title="Clear all filters">Clear</a>
      {{/if}}
    </div>
  </form>

  <!-- Items Grid -->
  {{#if items.length}}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 20px;">
      {{#each items}}
        {{> item-card this}}
      {{/each}}
    </div>

    <!-- Reusable Pagination Partial -->
    {{> pagination}}
  {{else}}
    <div class="glass-panel" style="text-align: center; padding: 64px 20px;">
      <div style="font-size: 48px; margin-bottom: 16px;">📁</div>
      <h3 style="font-size: 19px; margin-bottom: 6px; color: #f8fafc;">No Resource Items Found</h3>
      <p style="color: #94a3b8; font-size: 14px; max-width: 420px; margin: 0 auto 24px auto;">
        {{#if hasActiveFilters}}
          No items match your active filters. Try adjusting search criteria or clearing filters.
        {{else}}
          Your workspace has no resources yet. Create your first item to begin tracking project assets.
        {{/if}}
      </p>
      {{#if hasActiveFilters}}
        <a href="/dashboard" class="btn btn-secondary">Clear Active Filters</a>
      {{else}}
        <button type="button" class="btn btn-primary" id="btn-create-first-item">➕ Create Your First Resource</button>
      {{/if}}
    </div>
  {{/if}}
</div>

<!-- Modal Partials -->
{{> modals/item-modal}}
{{> modals/delete-modal}}
