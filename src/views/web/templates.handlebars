<div>
  <div class="page-header">
    <div>
      <h1 style="font-size: 28px; margin-bottom: 4px;">Handlebars Email Templates</h1>
      <p style="color: #94a3b8; font-size: 14px;">
        Live visual previews of all 10 responsive email templates compiled with dynamic context datasets
      </p>
    </div>
    <div style="display: flex; gap: 8px;">
      <button type="button" class="btn btn-primary btn-sm btn-device-switch" data-device="desktop" id="btn-device-desktop" aria-pressed="true">
        🖥️ Desktop
      </button>
      <button type="button" class="btn btn-secondary btn-sm btn-device-switch" data-device="mobile" id="btn-device-mobile" aria-pressed="false">
        📱 Mobile
      </button>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start;">
    <!-- Template Sidebar List -->
    <div class="glass-panel" style="padding: 16px; display: flex; flex-direction: column; gap: 6px; max-height: 800px; overflow-y: auto;" role="tablist" aria-label="Email Templates List">
      {{#each templateList}}
        <a href="/templates?template={{this.id}}" class="btn {{#if (eq ../activeTemplate.id this.id)}}btn-primary{{else}}btn-secondary{{/if}}" style="text-align: left; justify-content: flex-start; padding: 12px 14px; text-decoration: none;" role="tab" aria-selected="{{#if (eq ../activeTemplate.id this.id)}}true{{else}}false{{/if}}">
          <div style="width: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span style="font-size: 13px; font-weight: 700;">{{this.name}}</span>
              <span class="badge {{#if (eq ../activeTemplate.id this.id)}}badge-info{{else}}badge-muted{{/if}}" style="font-size: 9px;">{{this.badge}}</span>
            </div>
            <div style="font-size: 11px; color: #94a3b8; line-height: 1.3;">{{this.desc}}</div>
          </div>
        </a>
      {{/each}}
    </div>

    <!-- Preview Canvas -->
    <div class="glass-panel" style="padding: 24px; display: flex; flex-direction: column; align-items: center;">
      <div style="width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">
        <div>
          <span style="font-size: 16px; font-weight: 700; color: #f8fafc;">{{activeTemplate.name}}</span>
          <span style="font-size: 12px; color: #64748b; margin-left: 8px;">(Template: {{activeTemplate.id}}.handlebars)</span>
        </div>
        <div style="display: flex; gap: 8px;">
          <button type="button" class="btn btn-secondary btn-sm" id="btn-copy-preview-link" data-url="/api/v1/previews/{{activeTemplate.id}}" title="Copy URL to clipboard">
            📋 Copy URL
          </button>
          <a href="/api/v1/previews/{{activeTemplate.id}}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
            ↗ Open Raw HTML
          </a>
        </div>
      </div>

      <!-- Iframe device container -->
      <div id="preview-wrapper" style="width: 100%; max-width: 720px; transition: max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1); background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);">
        <iframe id="preview-iframe" src="/api/v1/previews/{{activeTemplate.id}}" style="width: 100%; height: 680px; border: none; display: block;" title="Email Template Preview: {{activeTemplate.name}}"></iframe>
      </div>
    </div>
  </div>
</div>
