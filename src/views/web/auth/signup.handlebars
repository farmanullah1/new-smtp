<div style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 20px;">
  <div class="glass-panel" style="max-width: 460px; width: 100%; padding: 36px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);">
    <!-- Brand Header -->
    <div style="text-align: center; margin-bottom: 28px;">
      <div style="width: 54px; height: 54px; border-radius: 14px; background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; box-shadow: 0 0 20px rgba(99, 102, 241, 0.5); font-size: 26px;">
        🛡️
      </div>
      <h1 style="font-size: 24px; margin-bottom: 6px;">Create an Account</h1>
      <p style="color: #94a3b8; font-size: 14px;">Register to start receiving dynamic emails and access the platform</p>
    </div>

    <!-- View Switcher -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; background: rgba(15, 23, 42, 0.7); padding: 4px; border-radius: 10px; margin-bottom: 24px; border: 1px solid rgba(255, 255, 255, 0.06);">
      <a href="/login" class="btn" style="background: transparent; color: #94a3b8; padding: 8px; font-size: 13px; text-decoration: none;">Sign In</a>
      <a href="/signup" class="btn" style="background: var(--gradient-brand); color: #ffffff; padding: 8px; font-size: 13px; text-decoration: none;">Sign Up</a>
    </div>

    <!-- Form -->
    <form action="/signup" method="POST">
      <div class="form-group">
        <label class="form-label" for="signup-name">Full Name</label>
        <input id="signup-name" type="text" name="name" class="form-input" placeholder="Farmanullah Ansari" value="{{name}}" required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label" for="signup-role">Account Role</label>
        <select id="signup-role" name="role" class="form-select">
          <option value="user">User (Standard Access)</option>
          <option value="admin">Admin (Full System Access)</option>
          <option value="moderator">Moderator</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="signup-email">Email Address</label>
        <input id="signup-email" type="email" name="email" class="form-input" placeholder="name@example.com" value="{{email}}" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="signup-password">Password</label>
        <div style="position: relative;">
          <input id="signup-password" type="password" name="password" class="form-input" placeholder="••••••••••••" minlength="6" style="padding-right: 42px;" required>
          <button type="button" class="btn-toggle-password" data-target="signup-password" style="position: absolute; right: 12px; top: 11px; background: none; border: none; cursor: pointer; font-size: 16px;">👁️</button>
        </div>

        <!-- Password Strength Meter -->
        <div style="margin-top: 8px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <span style="font-size: 11px; color: #94a3b8;">Password strength</span>
            <span id="pw-strength-label" style="font-size: 11px; font-weight: 700;"></span>
          </div>
          <div style="width: 100%; height: 4px; background: rgba(255, 255, 255, 0.1); border-radius: 2px; overflow: hidden;">
            <div id="pw-strength-bar" style="height: 100%; width: 0%; transition: all 0.3s ease;"></div>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; margin-top: 10px;">
        Create Free Account &rarr;
      </button>
    </form>
  </div>
</div>
