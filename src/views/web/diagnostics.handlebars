<div>
  <div class="page-header">
    <div>
      <h1 style="font-size: 28px; margin-bottom: 4px;">SMTP &amp; Infrastructure Diagnostics</h1>
      <p style="color: #94a3b8; font-size: 14px;">
        Real-time telemetry, transport status, and live end-to-end delivery test
      </p>
    </div>
    <a href="/diagnostics" class="btn btn-secondary btn-sm" aria-label="Refresh telemetry data">
      🔄 Refresh Telemetry
    </a>
  </div>

  <!-- Status Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 28px;">
    <!-- Database Health -->
    <div class="glass-panel metric-card" style="padding: 22px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <span style="font-size: 13px; font-weight: 600; color: #94a3b8;">Database Engine</span>
        <span style="font-size: 20px;">🗄️</span>
      </div>
      <div style="font-size: 20px; font-weight: 800; color: #f8fafc; margin-bottom: 4px;">
        {{health.database.dialect}}
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span class="badge {{#if (eq health.database.status 'healthy')}}badge-success{{else}}badge-danger{{/if}}">
          {{health.database.status}}
        </span>
        <span style="font-size: 12px; color: #64748b;">{{health.database.name}}</span>
      </div>
    </div>

    <!-- SMTP Connection -->
    <div class="glass-panel metric-card" style="padding: 22px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <span style="font-size: 13px; font-weight: 600; color: #94a3b8;">SMTP Transporter</span>
        <span style="font-size: 20px;">✉️</span>
      </div>
      <div style="font-size: 20px; font-weight: 800; color: #f8fafc; margin-bottom: 4px;">
        {{health.smtp.host}}:{{health.smtp.port}}
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span class="badge {{#if (eq health.smtp.status 'connected')}}badge-success{{else}}badge-warning{{/if}}">
          {{health.smtp.status}}
        </span>
        <span style="font-size: 12px; color: #64748b;">{{health.smtp.user}}</span>
      </div>
    </div>

    <!-- Server Uptime -->
    <div class="glass-panel metric-card" style="padding: 22px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <span style="font-size: 13px; font-weight: 600; color: #94a3b8;">Server Uptime</span>
        <span style="font-size: 20px;">⏱️</span>
      </div>
      <div style="font-size: 20px; font-weight: 800; color: #f8fafc; margin-bottom: 4px;">
        {{health.uptimeSeconds}}s
      </div>
      <span class="badge badge-info">{{health.environment}} mode</span>
    </div>

    <!-- Overall Status -->
    <div class="glass-panel metric-card" style="padding: 22px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <span style="font-size: 13px; font-weight: 600; color: #94a3b8;">Overall Status</span>
        <span style="font-size: 20px;">🛡️</span>
      </div>
      <div style="font-size: 20px; font-weight: 800; color: #34d399; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;">
        <span class="status-indicator-dot online"></span>
        <span>{{capitalize health.status}}</span>
      </div>
      <span style="font-size: 12px; color: #64748b;">Port 3000 Active</span>
    </div>
  </div>

  <!-- Live Test Email Dispatcher -->
  <div class="glass-panel" style="padding: 28px; margin-bottom: 28px;">
    <h2 style="font-size: 18px; margin-bottom: 6px;">🩺 Dispatch Live Diagnostic Email</h2>
    <p style="color: #94a3b8; font-size: 13px; margin-bottom: 20px;">
      Send an authentic test email via your configured Gmail SMTP server to verify inbox deliverability and template compilation.
    </p>

    <form method="POST" action="/diagnostics/send-test" style="display: flex; gap: 12px; flex-wrap: wrap; max-width: 600px;">
      <input type="email" name="testEmail" class="form-input" style="flex: 1; min-width: 260px;" placeholder="recipient@example.com" value="{{defaultTestEmail}}" required aria-label="Recipient Email">
      <button type="submit" class="btn btn-primary">
        🚀 Send Diagnostic Email
      </button>
    </form>
  </div>

  <!-- Telemetry Specifications -->
  <div class="glass-panel" style="padding: 24px;">
    <h2 style="font-size: 18px; margin-bottom: 14px;">Telemetry Details</h2>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <tbody>
          <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
            <td style="padding: 10px; color: #94a3b8; width: 220px;">Backend Architecture</td>
            <td style="padding: 10px; color: #f8fafc; font-weight: 600;">Node.js / Express 4.x / Handlebars SSR</td>
          </tr>
          <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
            <td style="padding: 10px; color: #94a3b8;">Database Layer</td>
            <td style="padding: 10px; color: #f8fafc; font-weight: 600;">Microsoft SQL Server (Sequelize ORM) with SQLite Resilience Fallback</td>
          </tr>
          <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
            <td style="padding: 10px; color: #94a3b8;">Email Engine</td>
            <td style="padding: 10px; color: #f8fafc; font-weight: 600;">Nodemailer (TLS/STARTTLS 587) with Exponential Backoff Retry</td>
          </tr>
          <tr>
            <td style="padding: 10px; color: #94a3b8;">Timestamp</td>
            <td style="padding: 10px; color: #38bdf8; font-family: monospace;">{{formatDateTime health.timestamp}}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
