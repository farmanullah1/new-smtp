<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="x-apple-disable-message-reformatting">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
  <title>{{subject}}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      background-color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      color: #1e293b;
    }
    table {
      border-collapse: collapse;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    img {
      border: 0;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }
    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #f1f5f9;
      padding: 30px 10px;
    }
    .main-card {
      max-width: 580px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
      border: 1px solid #e2e8f0;
    }
    .header-bar {
      background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
      padding: 28px 32px;
      text-align: center;
    }
    .brand-title {
      color: #ffffff;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin: 0;
    }
    .brand-subtitle {
      color: #bfdbfe;
      font-size: 13px;
      font-weight: 500;
      margin-top: 4px;
      margin-bottom: 0;
    }
    .content-body {
      padding: 36px 32px 24px 32px;
      font-size: 15px;
      line-height: 1.6;
      color: #334155;
    }
    .otp-code-box {
      background-color: #f8fafc;
      border: 2px dashed #cbd5e1;
      border-radius: 10px;
      padding: 18px 24px;
      text-align: center;
      margin: 24px 0;
    }
    .otp-digits {
      font-size: 34px;
      font-weight: 800;
      letter-spacing: 8px;
      color: #1e3a8a;
      font-family: 'Courier New', Courier, monospace;
      margin: 0;
    }
    .otp-subtext {
      font-size: 12px;
      color: #64748b;
      margin-top: 6px;
      margin-bottom: 0;
      font-weight: 500;
    }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-info {
      background-color: #e0f2fe;
      color: #0369a1;
    }
    .badge-warning {
      background-color: #fef3c7;
      color: #b45309;
    }
    .badge-danger {
      background-color: #fee2e2;
      color: #b91c1c;
    }
    .badge-success {
      background-color: #dcfce7;
      color: #15803d;
    }
    .action-button {
      display: inline-block;
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #ffffff !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      padding: 12px 28px;
      border-radius: 8px;
      margin: 20px 0;
      text-align: center;
    }
    .meta-table {
      width: 100%;
      margin: 18px 0;
      background-color: #f8fafc;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
    }
    .meta-table td {
      padding: 10px 14px;
      font-size: 13px;
      border-bottom: 1px solid #e2e8f0;
    }
    .meta-table tr:last-child td {
      border-bottom: none;
    }
    .meta-label {
      font-weight: 600;
      color: #475569;
      width: 35%;
    }
    .meta-val {
      color: #0f172a;
      font-weight: 500;
    }
    .security-notice {
      background-color: #fffbeb;
      border-left: 4px solid #f59e0b;
      padding: 14px 16px;
      border-radius: 0 8px 8px 0;
      margin: 22px 0 10px 0;
      font-size: 13px;
      color: #78350f;
    }
    .footer-bar {
      background-color: #f8fafc;
      border-top: 1px solid #e2e8f0;
      padding: 24px 32px;
      text-align: center;
      font-size: 12px;
      color: #64748b;
      line-height: 1.5;
    }
    .footer-links a {
      color: #3b82f6;
      text-decoration: none;
      margin: 0 8px;
    }
    @media only screen and (max-width: 600px) {
      .main-card {
        width: 100% !important;
        border-radius: 8px !important;
      }
      .content-body {
        padding: 24px 18px !important;
      }
      .header-bar {
        padding: 20px 18px !important;
      }
      .otp-digits {
        font-size: 28px !important;
        letter-spacing: 5px !important;
      }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
      <tr>
        <td align="center">
          <div class="main-card">
            <!-- Header -->
            <div class="header-bar">
              <h1 class="brand-title">{{appName}}</h1>
              <p class="brand-subtitle">Secure Notification & Authentication Services</p>
            </div>

            <!-- Dynamic Body Injected Here -->
            <div class="content-body">
              {{{body}}}
            </div>

            <!-- Footer -->
            <div class="footer-bar">
              <p style="margin: 0 0 8px 0;">This is an automated system email sent to <strong>{{recipientEmail}}</strong>.</p>
              <p style="margin: 0 0 12px 0;">Please do not reply directly to this email.</p>
              <div class="footer-links">
                <a href="{{clientUrl}}/help">Support Center</a> &bull;
                <a href="{{clientUrl}}/privacy">Privacy Policy</a> &bull;
                <a href="{{clientUrl}}/security">Security Details</a>
              </div>
              <p style="margin: 14px 0 0 0; color: #94a3b8; font-size: 11px;">
                &copy; {{currentYear}} {{appName}}. All rights reserved.
              </p>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
